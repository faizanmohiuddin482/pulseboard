# Production Environment Variables
# These are pre-configured for easy deployment

# GitHub App Configuration (pre-configured)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=your_private_key_here
GITHUB_APP_INSTALLATION_ID=789012
GITHUB_APP_NAME=github-jira

# Fallback OAuth Configuration (for development)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Application Configuration
NEXT_PUBLIC_APP_URL=https://github-jira.vercel.app
NODE_ENV=production

# Optional: Database for caching
# DATABASE_URL=postgresql://username:password@localhost:5432/github_jira
